# Must use the postgresql+asyncpg:// prefix; the sync driver blocks the loop.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/amagi

# Signs every JWT. Generate a real one, never ship this placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-ME-generate-a-random-value
